{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "framework": "vite",
  "env": {
    "VITE_API_BASE_URL": {
      "description": "API Gateway Base URL (production)"
    },
    "VITE_USER_SERVICE_PREFIX": {
      "description": "User Service API Prefix"
    },
    "VITE_CHAT_SERVICE_PREFIX": {
      "description": "Chat Service API Prefix"
    },
    "VITE_SOCIAL_SERVICE_PREFIX": {
      "description": "Social Service API Prefix"
    },
    "VITE_WS_BASE_URL": {
      "description": "WebSocket Base URL (production)"
    },
    "VITE_CHAT_WS_PATH": {
      "description": "Chat WebSocket Path"
    },
    "VITE_MAPBOX_TOKEN": {
      "description": "Mapbox Access Token"
    },
    "VITE_MAPBOX_STYLE": {
      "description": "Mapbox Style URL"
    },
    "VITE_MAP_CENTER_LNG": {
      "description": "Initial Map Center Longitude"
    },
    "VITE_MAP_CENTER_LAT": {
      "description": "Initial Map Center Latitude"
    },
    "VITE_MAP_ZOOM": {
      "description": "Initial Map Zoom Level"
    }
  }
}
